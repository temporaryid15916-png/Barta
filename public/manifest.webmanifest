{
  "id": "barta-e2ee-app",
  "name": "BARTA Secure Communication",
  "short_name": "BARTA",
  "description": "Connect Beyond Boundaries. Premium E2EE messaging and WebRTC communication.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": ["social", "security", "productivity"],
  "icons": [
    {
      "src": "./icons/barta-logo.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Encrypted Chat",
      "short_name": "New Chat",
      "description": "Start a new end-to-end encrypted direct message",
      "url": "./#new-chat",
      "icons": [{ "src": "./icons/barta-logo.svg", "sizes": "96x96" }]
    },
    {
      "name": "Secure Calls",
      "short_name": "Calls",
      "description": "View recent WebRTC audio/video calls",
      "url": "./#calls",
      "icons": [{ "src": "./icons/barta-logo.svg", "sizes": "96x96" }]
    }
  ]
}
